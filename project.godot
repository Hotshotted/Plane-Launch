; Engine configuration file.
config_version=5

[application]

config/name="Junkyard Launch"
config/description="Junkyard Launch by Clear Prop Games: an incremental glide-distance game."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.078, 0.129, 0.239, 1)

[autoload]

Tuning="*res://scripts/Tuning.gd"
Save="*res://scripts/Save.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.078, 0.129, 0.239, 1)
